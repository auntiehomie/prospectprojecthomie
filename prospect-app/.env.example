# Server-only OpenRouter key. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Comparison model must support structured outputs. Defaults to openai/gpt-5.2.
OPENROUTER_COMPARE_MODEL=openai/gpt-5.2

# Research model uses OpenRouter's web-search plugin. Defaults to compare model.
OPENROUTER_RESEARCH_MODEL=openai/gpt-5.2

# Required in production to protect the cost-bearing comparison endpoint.
PROSPECT_APP_ACCESS_CODE=

# Optional attribution URL sent to OpenRouter.
NEXT_PUBLIC_SITE_URL=
