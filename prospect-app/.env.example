# Server-only OpenRouter key. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Cost-first chain mirroring the OpenClaw TUI. OpenRouter tries models in order
# only when the earlier model errors, is unavailable/rate-limited, or refuses.
OPENROUTER_MODEL_CHAIN=nvidia/nemotron-3-ultra-550b-a55b:free,openai/gpt-5.6-sol,deepseek/deepseek-v4-pro

# Optional endpoint-specific comma-separated overrides.
OPENROUTER_RESEARCH_MODELS=
OPENROUTER_COMPARE_MODELS=

# Required in production to protect cost-bearing LLM endpoints.
PROSPECT_APP_ACCESS_CODE=

# Optional attribution URL sent to OpenRouter.
NEXT_PUBLIC_SITE_URL=
